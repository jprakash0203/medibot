# --- LLM ---
LLM_PROVIDER=groq                   # groq | openai
LLM_MODEL=openai/gpt-oss-120b   # or gpt-4o-mini for OpenAI
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1   # remove line for OpenAI

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medibot_chunks

# --- Auth ---
JWT_SECRET_KEY=change-me-to-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Paths ---
DATA_DIR=./data/mediassist_data
SQLITE_DB_PATH=./data/mediassist_data/db/mediassist.db

# --- Model configs ---
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Retrieval ---
RETRIEVAL_TOP_K=10                  # hybrid retrieval candidates
RERANK_TOP_K=3                      # after cross-encoder